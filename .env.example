# Copy to .env and fill passwords, or run: python3 scripts/init_env.py
# .env is local and ignored. Keep secrets out of tracked files and build context.
POSTGRES_DB=qh
POSTGRES_USER=qh
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

# Applications bind to 127.0.0.1. Databases have no published ports.
FRONTEND_PORT=5173
BACKEND_PORT=8000
MCP_PORT=3001

# Optional local OIDC profile; generate using python3 scripts/init_oidc_env.py
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_PASSWORD=
QH_ALICE_PASSWORD=
QH_BOB_PASSWORD=

# QH-7 manual Graphiti smoke only. No requests at startup or in CI.
# Put the real key only in the ignored VPS .env; never paste it in chat/logs.
MISTRAL_API_KEY=
# Explicit model selection required after pinned Graphiti compatibility review.
MISTRAL_LLM_MODEL=
MISTRAL_EMBEDDING_MODEL=mistral-embed
