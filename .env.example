# Copy to .env and fill passwords, or run: python3 scripts/init_env.py
# .env is local and ignored. Keep secrets out of tracked files and build context.
POSTGRES_DB=qh
POSTGRES_USER=qh
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

# Applications bind to 127.0.0.1. Databases have no published ports.
FRONTEND_PORT=5173
BACKEND_PORT=8000
MCP_PORT=3001

# Optional local OIDC profile; generate using python3 scripts/init_oidc_env.py
KEYCLOAK_PORT=8080
# Optional reviewed theme image; empty retains upstream for a fresh local install.
# VPS selection/recreation is separately authorized under docs/qh-49-keycloak-delivery.md.
QH_KEYCLOAK_IMAGE=
KEYCLOAK_ADMIN_PASSWORD=
QH_ALICE_PASSWORD=
QH_BOB_PASSWORD=

# Native runtime opt-in: requires explicitly authorized 0003/0004 cutover.
QH_NATIVE_CONTEXT_ENABLED=false
QH_NATIVE_GRAPH_NAMESPACE=qh-native
# Only used by the explicit qh30-runtime.yml cutover override; build/pin before use.
QH_NATIVE_BACKEND_IMAGE=qh-native-backend:reviewed-commit

# Image-only VPS override (qh-immutable.yml), explicit reviewed images only.
# No effect on the default development Compose; configure only for an authorized activation.
QH_FRONTEND_IMAGE=
QH_MCP_IMAGE=

# Server-only key; QH-45 scoped sessions require separate receipt, ledger and in-app consent.
MISTRAL_API_KEY=

# QH-45 interactive sessions remain denied unless separately authorized server-side.
QH_CHAT_SESSIONS_ENABLED=false
QH_CHAT_SESSION_AUTHORIZATION_FILE=
QH_CHAT_SESSION_LEDGER_FILE=

# QH-52 prepared development profile. Enable only after the separate VPS gate.
# Frontend build/dev environment flag; requires verified Keycloak refresh rotation.
VITE_QH_DEVELOPMENT_SESSION=0
# Backend default preserves legacy token-bound grants and the existing ledger.
QH_CHAT_SESSION_BINDING=credential

# Explicit private Demo B overlay, enabled only after authorized backup/activation.
QH_PRIVATE_SHARING=0
# Exact reviewed frontend IPv4 on the private app network; no wildcard proxy trust.
QH_SHARING_FRONTEND_IP=
# Real guest Mistral requires the explicit owner receipt and same cumulative ledger.
# Always false in automatic-test setups; never enables inference on page load.
QH_GUEST_MISTRAL_ENABLED=false
