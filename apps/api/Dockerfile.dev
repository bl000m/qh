FROM ghcr.io/astral-sh/uv:0.8.4 AS uv
FROM python:3.12.9-slim-bookworm
COPY --from=uv /uv /usr/local/bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace/apps/api
COPY apps/api/requirements.lock ./
RUN uv pip install --system --require-hashes --only-binary :all: --no-deps -r requirements.lock
COPY apps/api ./
COPY tests /workspace/tests
COPY scripts /workspace/scripts
COPY ruff.toml /workspace/ruff.toml
EXPOSE 8000
CMD ["uvicorn", "app.bootstrap:create_runtime_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "app", "--reload-dir", "adapters"]
